                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  },
                  "spice": {
                    "type": "string",
                    "enum": [
                      "mild",
                      "medium",
                      "spicy"
                    ]
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "remote",
                      "same-room"
                    ]
                  },
                  "adult": {
                    "default": false,
                    "type": "boolean"
                  },
                  "gameMode": {
                    "type": "string",
                    "enum": [
                      "bluff",
                      "spotlight"
                    ]
                  },
                  "seatCount": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 7
                  },
                  "packId": {
                    "type": "string",
                    "enum": [
                      "hostel-2am",
                      "goa-trip"
                    ]
                  },
                  "avatar": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 560003
                  },
                  "color": {
                    "type": "string",
                    "enum": [
                      "#ffb020",
                      "#b5b2d8",
                      "#dca58d",
                      "#a8baa0",
                      "#93bed2"
                    ]
                  },
                  "hostLanguage": {
                    "type": "string",
                    "enum": [
                      "en",
                      "hi",
                      "hinglish"
                    ]
                  },
                  "pace": {
                    "type": "string",
                    "enum": [
                      "quick",
                      "normal",
                      "relaxed"
                    ]
                  },
                  "guidedVoice": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "spice",
                  "mode",
                  "adult"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
