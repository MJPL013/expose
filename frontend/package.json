{
  "name": "@expose/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write src tests *.ts *.mjs package.json tsconfig.json README.md",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@expose/shared": "*",
    "@fontsource-variable/bricolage-grotesque": "^5.2.0",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.2.0",
    "@fontsource/anton": "^5.2.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
