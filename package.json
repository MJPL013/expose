{
  "name": "expose",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs --production",
    "playtest": "node scripts/playtest.mjs",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "build": "npm run typecheck -w shared && npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w frontend && npm run typecheck -w backend",
    "test": "npm run test -w frontend && npm run test -w backend",
    "test:e2e": "npm run test:e2e -w frontend",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run db:migrate -w backend",
    "report": "npm run report -w backend",
    "contracts": "npm run contracts -w backend"
  }
}
