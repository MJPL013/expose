DATABASE_URL=postgres://expose:expose_local_only@127.0.0.1:5433/expose
PORT=4000
PUBLIC_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
MEDIA_ROOT=.data/media
AI_ENABLED=false
HOST_DIRECTOR_ENABLED=true
# smoke is deliberately bounded; full-match derives separate voice/host/translation caps from roster size.
AI_PROFILE=smoke
AI_STOP_FILE=.data/ai-stopped
GNANI_API_KEY=
GNANI_STT_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_MODEL=prisma-v3.0
# Legacy fallback only. New recordings supply en-IN, hi-IN or te-IN individually.
GNANI_STT_LANGUAGES=hi-IN
# Opt in after account qualification; false retains silence-based finalisation.
GNANI_STT_COMMIT=false
GNANI_TTS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Avinash
# Keep keys in backend/.env only. Choose one host provider; no automatic paid fallback.
HOST_LLM_PROVIDER=scripted
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GNANI_BATCH_URL=https://api.vachana.ai/stt/v3/batch/jobs
MAX_AUDIO_SECONDS=60
MAX_TTS_CHARACTERS=1000
MAX_LLM_CALLS=4
MAX_TRANSLATION_CALLS=12
MAX_DIAGNOSTIC_SECONDS=60
